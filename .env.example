PORT=4000

# AI explanation service (Python, ai-service/). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000

# Where the Node API finds the Python service.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=25000
# Set to "none" to skip the AI service and always use the rule-based summary.
AI_PROVIDER=gemini

# Only needed if the client is served separately from the API (e.g. hosted frontend).
# Leave unset in development: Vite proxies /api to the server.
# VITE_API_URL=https://your-api.example.com
