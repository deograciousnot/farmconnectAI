PORT=4000

# Ollama runs the AI explanation locally. Install from https://ollama.com, then: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=30000
# Set to "none" to skip the model and always use the rule-based summary.
AI_PROVIDER=ollama

# Only needed if the client is served separately from the API (e.g. hosted frontend).
# Leave unset in development: Vite proxies /api to the server.
# VITE_API_URL=https://your-api.example.com
